# Copy this file to .env and replace placeholders. Never commit .env.
# Use the Base64 encoded token shown when creating a Text personal access token.
TEXT_TOKEN_BASE64=replace-with-base64-encoded-token-from-text
HUBSPOT_ACCESS_TOKEN=replace-with-hubspot-service-key-or-existing-private-app-token

# Listener settings. The organization ID is resolved from your token automatically.
HOST_PORT=8080

# Optional local testing overrides; encrypted transport is required outside loopback.
# HUBSPOT_URL=https://api.hubapi.com
# TEXT_CDP_URL=https://api.text.com/cdp
# TEXT_ACCOUNTS_URL=https://accounts.text.com
# TEXT_RTM_URL=wss://api.livechatinc.com/v3.6/agent/rtm/ws
# HTTP_MIN_INTERVAL=200ms
